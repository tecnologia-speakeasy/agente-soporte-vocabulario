# Copia este archivo a .env.local (local) o configura estas variables en Vercel.

DATABASE_URL=               # postgres://usuario:clave@host:5432/base (en Vercel usa la URL del pooler)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5   # id del modelo de Claude a usar
ANTHROPIC_EFFORT=low        # opcional: low | medium | high | xhigh | max | none (none = no enviar el parámetro)
GHL_API_TOKEN=              # Private Integration Token de la subcuenta
GHL_LOCATION_ID=
GHL_WEBHOOK_SECRET=         # debe coincidir con el header x-webhook-secret del flujo (mín. 16 caracteres)
GHL_MOTIVO_ESCALADO_FIELD_ID=   # id del campo personalizado motivo_escalado
SESSION_TTL_HOURS=24
DEBOUNCE_SECONDS=8
HISTORY_LIMIT=20
ADMIN_TOKEN=                # para endpoints de prueba/admin (mín. 16 caracteres)
PANEL_PASSWORD=             # contraseña del panel /admin (mín. 10 caracteres); si está vacía se usa ADMIN_TOKEN
# PANEL_ZONA_HORARIA=America/Bogota   # opcional: zona horaria de fechas y días del panel
# DATABASE_POOL_MAX=5       # opcional: conexiones máximas por instancia
